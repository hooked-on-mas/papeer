{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PaperDesk",
  "version": "0.2.0",
  "identifier": "local.paperdesk",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "PaperDesk — 日本語で論文を読む",
        "width": 1380,
        "height": 880,
        "minWidth": 1000,
        "minHeight": 680,
        "zoomHotkeysEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "sidecar"
    ]
  }
}
