# Generated by Cargo
# will have compiled files and executables
/target/

# Generated by Tauri
# will have schema files for capabilities auto-completion
/gen/schemas
# The onedir sidecar that `just build-sidecar` places for bundle.resources (tools/place_sidecar.py makes the
# .new/.old folders only while it swaps it in). tauri dev's watcher skips what is ignored here.
/sidecar/
/sidecar.new/
/sidecar.old/
# The onefile sidecar of earlier builds (externalBin), no longer used.
sidecar-*.exe
