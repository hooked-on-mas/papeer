    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@dnd-kit/core": "^6.3.1",
    "@fontsource-variable/geist": "^5.3.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "@tanstack/react-query": "^5.108.2",
    "@tanstack/react-virtual": "^3.14.26",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "@tauri-apps/plugin-notification": "^2.8.1",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-process": "^2.4.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "codemirror": "^6.0.2",
    "katex": "^0.19.1",
    "lucide-react": "^1.77.0",
    "mermaid": "^12.3.0",
    "openapi-fetch": "^0.17.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.5.438",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hotkeys-hook": "^5.4.0",
    "react-markdown": "^10.1.0",
    "react-pdf": "^11.1.0",
    "react-resizable-panels": "^4.24.1",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "11.0.0",
    "unified": "11.0.5",
    "zustand": "^5.1.0"
