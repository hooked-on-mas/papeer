{
  "name": "papeer",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "dev:web": "vite --config vite.web.config.ts",
    "build:web": "tsc && vite build --config vite.web.config.ts",
    "preview": "vite preview",
    "tauri": "tauri",
    "test": "node --test \"tests/*.test.*\"",
    "test:web": "node scripts/test-web.mjs",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tests && tsc --noEmit -p e2e",
    "lint": "eslint --max-warnings 0 .",
    "gen-api": "openapi-typescript openapi.json --default-non-nullable false -o src/api/schema.d.ts"
  },
  "engines": {
    "node": ">=22.18"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@dnd-kit/core": "^6.3.1",
    "@fontsource-variable/geist": "^5.3.0",
    "@tanstack/react-query": "^5.104.2",
    "@tanstack/react-virtual": "^3.14.15",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.8.2",
    "@tauri-apps/plugin-notification": "^2.6.0",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-process": "^2.4.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "codemirror": "^6.0.2",
    "katex": "^0.19.0",
    "lucide-react": "^1.55.0",
    "mermaid": "^12.1.0",
    "openapi-fetch": "^0.17.0",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-hotkeys-hook": "^5.3.3",
    "react-markdown": "^10.1.0",
    "react-pdf": "^11.0.0",
    "react-resizable-panels": "^4.14.4",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2",
    "@types/katex": "^0.16.8",
