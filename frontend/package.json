  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "dev:web": "vite --config vite.web.config.ts",
    "build:web": "tsc && vite build --config vite.web.config.ts",
    "preview": "vite preview",
    "tauri": "tauri",
    "test": "node --test \"tests/**/*.test.*\"",
    "test:web": "node scripts/test-web.mjs",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tests && tsc --noEmit -p e2e",
    "lint": "eslint --max-warnings 0 .",
    "gen-api": "openapi-typescript openapi.json --default-non-nullable false -o src/api/schema.d.ts"
  },
  "engines": {
    "node": ">=22.18"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@codemirror/lang-markdown": "^6.5.2",
