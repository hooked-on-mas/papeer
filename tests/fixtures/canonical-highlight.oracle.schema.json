{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Design of the generated oracle; no measured browser output may be copied here.",
  "type": "object",
  "required": ["version", "file", "metadata", "pages", "tolerances", "fontSources"],
  "properties": {
    "version": { "const": 1 },
    "file": { "const": "canonical-highlight.pdf" },
    "metadata": { "type": "object", "required": ["id", "sha256", "mediaType", "byteLength", "pdfPages"] },
    "pages": {
      "type": "array", "minItems": 8, "maxItems": 8,
      "items": {
        "type": "object", "required": ["physicalPage", "rotation", "userUnit"],
        "properties": {
          "physicalPage": { "type": "integer", "minimum": 1, "maximum": 8 },
          "rotation": { "enum": [0, 90, 180, 270] },
          "userUnit": { "enum": [1, 2] },
          "canonicalBand": { "type": "array", "minItems": 4, "maxItems": 4, "items": { "type": "number" } },
          "canonicalAxis": { "type": "array", "minItems": 4, "maxItems": 4, "items": { "type": "number" } },
          "requiredActualText": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "tolerances": { "type": "object", "required": ["advancePt", "bandPt", "overlayClientPx"] },
    "fontSources": { "type": "array", "minItems": 2, "items": { "type": "string" } }
  }
}
